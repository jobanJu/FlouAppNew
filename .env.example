# ============================================
# FLOU APP - Configuration Environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# Server
NODE_ENV=development
PORT=3000

# Supabase
SUPABASE_URL=https://lqzsgugobujvweeuxves.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Agora (Video/Audio)
AGORA_APP_ID=2d6f68f6a59b4622ac64393266c8f828
AGORA_APP_CERTIFICATE=166070eec4344f8e8374f701324d5c6a

# Redis (optionnel - pour cache distribué)
# REDIS_URL=redis://localhost:6379

# Cloudflare Turnstile (anti-bot)
# Obtenir sur: https://dash.cloudflare.com/turnstile
# TURNSTILE_SITE_KEY=your_site_key
# TURNSTILE_SECRET_KEY=your_secret_key

# JWT (générer une clé sécurisée en prod)
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Sentry (error tracking)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Cloudinary (CDN images)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# CORS
CORS_ORIGINS=https://flouapp.up.railway.app,http://localhost:3000
